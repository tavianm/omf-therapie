---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Navbar from '../components/islands/Navbar';
import { AdminWorkspace } from '../components/admin/AdminWorkspace';
import { auth } from '../lib/auth';
import { isAdminSession } from '../lib/authz';
import { supabaseAdmin } from '../lib/supabase';
import type { Appointment } from '../types/appointment';

const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session) return Astro.redirect('/login/?redirect=/mes-rdvs/');
if (!isAdminSession(session))
  return Astro.redirect('/login/?error=acces-refuse');

const APPOINTMENT_COLUMNS = [
  'id',
  'status',
  'scheduled_at',
  'scheduled_end',
  'blocked_until',
  'rescheduled_to',
  'appointment_type',
  'appointment_mode',
  'duration',
  'base_price',
  'discount',
  'final_price',
  'credit_applied',
  'is_first_session',
  'patient_name',
  'patient_email',
  'patient_phone',
  'patient_postal_code',
  'patient_city',
  'patient_reason',
  'therapist_notes',
  'video_link',
  'google_calendar_event_id',
  'stripe_payment_link_url',
  'stripe_payment_link_id',
  'stripe_payment_intent_id',
  'confirmation_sent_at',
  'invitation_sent_at',
  'created_at',
  'updated_at',
  'deleted_at',
].join(',');

const { data: rows, error } = await supabaseAdmin
  .from('appointments')
  .select(APPOINTMENT_COLUMNS)
  .is('deleted_at', null)
  .order('scheduled_at', { ascending: false });

if (error) console.error('[mes-rdvs] Erreur Supabase :', error);
const appointments: Appointment[] = error
  ? []
  : (rows as unknown as Appointment[]);
---

<Layout
  title="Mes rendez-vous — OMF Thérapie"
  description="Poste de travail de gestion des rendez-vous."
  noindex={true}
>
  <Navbar client:load isAuthenticated={true} />
  <main class="min-h-screen bg-sage-50 px-4 pb-12 pt-24 sm:px-6 lg:px-8">
    <AdminWorkspace client:load appointments={appointments} />
  </main>
</Layout>
