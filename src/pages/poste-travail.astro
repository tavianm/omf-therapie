---
/**
 * /poste-travail — espace de gestion admin, proposition B (issue #148).
 *
 * Seconde proposition de refonte du tableau de bord (Figma « Refonte admin »),
 * livrée sur une route dédiée pour comparaison A/B avec /mes-rdvs (proposition A).
 * Garde auth et chargement des données identiques à /mes-rdvs ; le rendu
 * interactif est délégué à l'island React Workbench.
 */

export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { Workbench } from '../components/admin/workbench/Workbench';
import { auth } from '../lib/auth';
import { isAdminSession } from '../lib/authz';
import { fetchActiveAppointments } from '../lib/admin-appointments';
import {
  LOGIN_PATH_FORBIDDEN,
  LOGIN_PATH_UNAUTHENTICATED,
} from '../utils/login-redirects';

// ── Auth guard ───────────────────────────────────────────────────────────────
// Redirections partagées avec le hook de polling (SC7 — miroir exact) :
// voir src/utils/login-redirects.ts.
const session = await auth.api.getSession({ headers: Astro.request.headers });
if (!session) {
  return Astro.redirect(LOGIN_PATH_UNAUTHENTICATED);
}
if (!isAdminSession(session)) {
  return Astro.redirect(LOGIN_PATH_FORBIDDEN);
}

const practitionerName = session.user?.name ?? 'Oriane Montabonnet';

// ── Fetch appointments ───────────────────────────────────────────────────────
// Requête partagée (mêmes colonnes explicites, soft-delete exclu, tri identique
// que /mes-rdvs) : voir src/lib/admin-appointments.ts. En cas d'erreur, la page
// est rendue avec une liste vide — dégradation identique à l'extraction.
const { appointments, error } = await fetchActiveAppointments();

if (error) {
  console.error('[poste-travail] Erreur Supabase :', error);
}
---

<Layout
  title="Poste de travail — OMF Thérapie"
  description="Espace de gestion des rendez-vous, des patients et du planning."
  noindex={true}
>
  <Workbench client:load appointments={appointments} practitionerName={practitionerName} />
</Layout>
